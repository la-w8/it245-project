import java.util.Queue;

/**
 * Solution 1: Queue Scheduling (FIFO / First-Come, First-Served)
 * Executes tasks in the order they arrived, using Java's Queue data structure.
 */
public class QueueScheduling {

    /**
     * Executes tasks in FCFS order using a Queue.
     * Calculates start time, finish time, waiting time, and turnaround time for each task.
     *
     * @param tasks a Queue containing tasks in their arrival order
     */
    public static void queueScheduling(Queue<Task> tasks) {
        System.out.println("===== FIFO / Queue Scheduling (FCFS) =====");

        int currentTime = 0;
        int totalWaitingTime = 0;
        int totalTurnaroundTime = 0;
        int taskCount = tasks.size();

        // Process tasks one by one until the queue is empty
        while (!tasks.isEmpty()) {
            Task current = tasks.poll(); // remove the task at the front of the queue

            // If the processor is idle waiting for the task to arrive
            if (currentTime < current.arrivalTime) {
                currentTime = current.arrivalTime;
            }

            int startTime = currentTime;
            int waitingTime = startTime - current.arrivalTime;
            int finishTime = startTime + current.burstTime;
            int turnaroundTime = finishTime - current.arrivalTime;

            totalWaitingTime += waitingTime;
            totalTurnaroundTime += turnaroundTime;

            System.out.println(current +
                    " | Start=" + startTime +
                    " | Finish=" + finishTime +
                    " | Waiting=" + waitingTime +
                    " | Turnaround=" + turnaroundTime);

            currentTime = finishTime;
        }

        System.out.println("--------------------------------------------");
        System.out.printf("Average Waiting Time    : %.2f%n", (double) totalWaitingTime / taskCount);
        System.out.printf("Average Turnaround Time : %.2f%n", (double) totalTurnaroundTime / taskCount);
        System.out.println("============================================");
    }
}
